# Las Vegas site only
# Do not add these variables to the Little Rock Netlify site.
# Leave a line blank only when the setup doc says that variable is optional.
# Shop name lines must be copied exactly.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_DATABASE_URL=

REACT_APP_SHOP_NAME=Gameday Las Vegas Buying Tracker
REACT_APP_APP_TITLE=Gameday Las Vegas Buying Tracker
REACT_APP_SHOP_SHORT_NAME=Gameday Las Vegas Buying Tracker
REACT_APP_SHOP_ID=gameday-las-vegas

# Optional. Unset uses In Shop, Buying desk, #ed1c24, and the GameDay logo file.
# REACT_APP_SHOP_LOCATION_LABEL=In Shop
# REACT_APP_SHOP_TAGLINE=Buying desk
# REACT_APP_SHOP_ACCENT_COLOR=#ed1c24
# REACT_APP_SHOP_LOGO_URL=

# Server only. Generate a new encryption key. Do not copy the Little Rock key.
# IDENTITY_ENCRYPTION_KEY=
# PSA_API_TOKEN=
