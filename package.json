{
  "name": "buying-tracker",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@zxing/browser": "^0.1.5",
    "firebase": "^12.13.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node scripts/with-shop-env.mjs npm run start:app",
    "start:app": "node scripts/write-shop-env.mjs && react-scripts start",
    "build": "node scripts/with-shop-env.mjs npm run build:app",
    "build:app": "node scripts/write-shop-env.mjs && GENERATE_SOURCEMAP=false react-scripts build && node scripts/brand-build.mjs",
    "test": "node scripts/write-shop-env.mjs && react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "firebase-tools": "^14.26.0",
    "puppeteer-core": "^24.15.0"
  }
}
